rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow signed-in users to read questions
    match /questionBank/{docId} {
      allow read, list: if request.auth != null;
    }

    // Allow users to create, update, and read their own answers
    // Also allow group members to read answers posted to their group
    match /answers/{answerId} {
      allow get, list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (
          resource.data.groupIds is list &&
          resource.data.groupIds.size() > 0 &&
          groupAccess(resource.data.groupIds)
        )
      );

      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }




    // Allow users to read group info if they are a member
    match /groups/{groupId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.uid in resource.data.members);
    }

    // Allow users to read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
